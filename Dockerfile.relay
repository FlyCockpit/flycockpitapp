# Base image: official node:24.22.1-trixie-slim (multi-arch index digest,
# built 2026-10-21). Node >= 24.22.1 ships the bundled CA store fix for the
# eMudhra intermediate compromise (CVE-2026-111943); the previous pin was
# Node 24.19.0. Bump the digest only to an image carrying an equal or newer
# Node 24 release.
FROM node:24-trixie-slim@sha256:43b9ba1142b8dcf33fa8f922ca1be85714adc444e0586c7cf7726daaeabc1bea AS base

# Runtime base pinned to the same immutable official Node Trixie image as
# Dockerfile/Dockerfile.worker:
# pull Debian security patches while avoiding server/worker-only packages such
# as postgresql-client, Prisma CLI, and ffmpeg. The relay owns no schema work.
RUN apt-get update -y && apt-get upgrade -y && apt-get install -y ca-certificates \
  && rm -rf /var/lib/apt/lists/*
# CVE-2026-111943 (eMudhra): ca-certificates 20250419+deb13u1 removes the
# distrusted emSign ECC Root CA - G3. Fail the build if apt resolved anything
# older (e.g. a stale mirror), instead of shipping the vulnerable bundle.
RUN dpkg --compare-versions "$(dpkg-query -W -f='${Version}' ca-certificates)" ge 20250419+deb13u1

FROM base AS build-base

RUN apt-get update -y && apt-get install -y \
  git \
  && rm -rf /var/lib/apt/lists/*

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@11.1.2 --activate

FROM build-base AS builder

WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml turbo.json ./
COPY apps/relay/package.json apps/relay/
COPY packages/config/package.json packages/config/
COPY packages/env/package.json packages/env/
COPY packages/relay-protocol/package.json packages/relay-protocol/

RUN node -e "const f='package.json';const p=JSON.parse(require('fs').readFileSync(f));delete p.scripts.postinstall;require('fs').writeFileSync(f,JSON.stringify(p,null,2))"
RUN pnpm install --frozen-lockfile

COPY . .

RUN node -e "const f='package.json';const p=JSON.parse(require('fs').readFileSync(f));delete p.scripts.postinstall;require('fs').writeFileSync(f,JSON.stringify(p,null,2))"

RUN pnpm turbo build --filter=relay
RUN test -f apps/relay/dist/index.mjs

FROM build-base AS prod-deps

WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/relay/package.json apps/relay/
COPY packages/config/package.json packages/config/
COPY packages/env/package.json packages/env/
COPY packages/relay-protocol/package.json packages/relay-protocol/

RUN pnpm install --frozen-lockfile --prod --ignore-scripts --filter=relay...

FROM base AS runner

ENV NODE_ENV=production
WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/relay/package.json apps/relay/

COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=prod-deps /app/apps/relay/node_modules ./apps/relay/node_modules
COPY --from=builder /app/apps/relay/dist ./apps/relay/dist

RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

USER node

EXPOSE 3010

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD node -e "const port=process.env.RELAY_PORT||process.env.PORT||3010;fetch('http://localhost:'+port+'/healthz').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/relay/dist/index.mjs"]
