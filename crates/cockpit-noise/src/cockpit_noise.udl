namespace cockpit_noise {
  [Throws=NoiseBindingError]
  u64 noise_create_initiator(sequence<u8> prologue, u32 transport_epoch);
  [Throws=NoiseBindingError]
  u64 noise_create_responder(sequence<u8> prologue, u32 transport_epoch);
  [Throws=NoiseBindingError]
  sequence<u8> noise_write_handshake(u64 handle);
  [Throws=NoiseBindingError]
  void noise_read_handshake(u64 handle, sequence<u8> frame);
  [Throws=NoiseBindingError]
  sequence<u8> noise_handshake_hash(u64 handle);
  [Throws=NoiseBindingError]
  void noise_authorize(u64 handle, sequence<u8> client_final_proof, sequence<u8> daemon_final_proof, BindingAuthorizationGate gate);
  [Throws=NoiseBindingError]
  sequence<u8> noise_encrypt_record(u64 handle, u8 kind, sequence<u8> payload);
  [Throws=NoiseBindingError]
  sequence<u8> noise_encrypt_fallback_record(u64 handle, u8 kind, u64 route_generation, u8 direction, u64 peer_seen_through, sequence<u8> payload);
  [Throws=NoiseBindingError]
  sequence<u8> noise_encrypt_fallback_rekey_action(u64 handle, u8 kind, u64 route_generation, u8 direction, u64 peer_seen_through, sequence<u8> control_payload);
  [Throws=NoiseBindingError]
  void noise_bind_fallback_route(u64 handle, u64 route_generation);
  [Throws=NoiseBindingError]
  sequence<u8> noise_decrypt_record(u64 handle, u64 routing_sequence, sequence<u8> ciphertext);
  [Throws=NoiseBindingError]
  sequence<u8> noise_decrypt_fallback_record(u64 handle, sequence<u8> outer_record);
  void noise_close(u64 handle);
  [Throws=NoiseBindingError]
  u64 fallback_create(u64 now_millis);
  [Throws=NoiseBindingError]
  sequence<u8> fallback_observe(u64 handle, sequence<u8> outer_record);
  [Throws=NoiseBindingError]
  sequence<u8> fallback_ack_due(u64 handle, u64 now_millis, boolean immediate, boolean received_ack_only);
  [Throws=NoiseBindingError]
  void fallback_cache_outgoing(u64 handle, u64 sequence, sequence<u8> ciphertext, u8 kind);
  [Throws=NoiseBindingError]
  void fallback_acknowledge(u64 handle, u64 largest_contiguous);
  [Throws=NoiseBindingError]
  sequence<u8> fallback_gap_retransmit(u64 handle, u64 next_missing);
  [Throws=NoiseBindingError]
  sequence<u8> fallback_retry_due(u64 handle, u64 elapsed_millis);
  void fallback_close(u64 handle);
};

dictionary BindingAuthorizationRequest {
  sequence<u8> child_attempt_id;
  u32 transport_epoch;
  sequence<u8> handshake_hash;
  sequence<u8> prologue_digest;
  sequence<u8> connection_nonce;
  sequence<u8> initiator_ephemeral;
  sequence<u8> responder_ephemeral;
  sequence<u8> client_final_proof;
  sequence<u8> daemon_final_proof;
};

callback interface BindingAuthorizationGate {
  boolean authorize(BindingAuthorizationRequest request);
};

[Error]
enum NoiseBindingError {
  "InvalidInput",
  "InvalidState",
  "AuthenticationFailed",
  "Closed",
  "Internal",
};
