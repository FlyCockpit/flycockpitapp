[Unit]
Description=FlyCockpit privileged descendant containment broker for UID %i
Documentation=https://docs.flycockpit.com/
After=local-fs.target
Before=cockpit-daemon@%i.service
ConditionPathIsMountPoint=/sys/fs/cgroup

[Service]
Type=simple
User=root
Group=root
OpenFile=/etc/flycockpit/containment-capability-%i:flycockpit-containment-capability:read-only
ExecStart=/usr/libexec/flycockpit/cockpit-containment-broker --allowed-uid %i --socket /run/flycockpit/containment-broker-%i.sock
RuntimeDirectory=flycockpit
RuntimeDirectoryMode=0755
StateDirectory=flycockpit/containment-broker-%i
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=false
PrivateDevices=yes
PrivateNetwork=no
PrivateTmp=no
ProtectClock=yes
ProtectControlGroups=no
ProtectHome=no
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/run/flycockpit /var/lib/flycockpit/containment-broker-%i -/sys/fs/cgroup/flycockpit
ProtectProc=invisible
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_CHOWN CAP_SETGID CAP_SETPCAP CAP_SETUID CAP_SYS_ADMIN
AmbientCapabilities=
Restart=always
RestartSec=1s

[Install]
WantedBy=multi-user.target
