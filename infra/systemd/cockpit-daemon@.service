[Unit]
Description=FlyCockpit daemon for UID %i
Documentation=https://docs.flycockpit.com/
Wants=cockpit-containment-broker@%i.service
After=cockpit-containment-broker@%i.service

[Service]
Type=simple
User=%i
OpenFile=/etc/flycockpit/containment-capability-%i:flycockpit-containment-capability:read-only
ExecStart=/usr/bin/cockpit daemon start --foreground
# A daemon unit is not ready merely because its process exists. Run the same
# authenticated broker handshake under User=%i with the service-manager-opened
# capability before systemd may classify this unit as active.
ExecStartPost=/usr/libexec/flycockpit/cockpit-containment-broker --doctor --allowed-uid %i --socket /run/flycockpit/containment-broker-%i.sock --capability-fd 3
Restart=on-failure
RestartSec=1s
NoNewPrivileges=yes
PrivateDevices=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
