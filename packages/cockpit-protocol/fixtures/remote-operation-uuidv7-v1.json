{
  "schemaVersion": 1,
  "note": "Shared cross-language UUIDv7 (RFC 9562) operation-identity vectors. Both Rust and TypeScript build the id from the same 48-bit big-endian unixMs and 16 random bytes: bytes 0-5 = timestamp, high nibble of byte 6 = version 7, top two bits of byte 8 = RFC variant, all other bits random.",
  "vectors": [
    {
      "name": "epoch_zero_timestamp",
      "unixMs": 0,
      "randomHex": "00000000000000000000000000000000",
      "expected": "00000000-0000-7000-8000-000000000000"
    },
    {
      "name": "epoch_random_bits",
      "unixMs": 0,
      "randomHex": "ffffffffffffffffffffffffffffffff",
      "expected": "00000000-0000-7fff-bfff-ffffffffffff"
    },
    {
      "name": "typical_2024",
      "unixMs": 1704067200000,
      "randomHex": "0123456789abcdeffedcba9876543210",
      "expected": "018cc251-f400-7def-bedc-ba9876543210"
    },
    {
      "name": "mixed_bits",
      "unixMs": 1723593600123,
      "randomHex": "a1b2c3d4e5f60718293a4b5c6d7e8f90",
      "expected": "01914e2f-2c7b-7718-a93a-4b5c6d7e8f90"
    },
    {
      "name": "max_48bit_timestamp",
      "unixMs": 281474976710655,
      "randomHex": "ffffffffffffffffffffffffffffffff",
      "expected": "ffffffff-ffff-7fff-bfff-ffffffffffff"
    },
    {
      "name": "boundary_one",
      "unixMs": 1,
      "randomHex": "1112131415161718191a1b1c1d1e1f20",
      "expected": "00000000-0001-7718-991a-1b1c1d1e1f20"
    }
  ],
  "rejectedUnixMs": [
    {
      "name": "just_over_48bit",
      "unixMs": 281474976710656
    },
    {
      "name": "far_over_48bit",
      "unixMs": 4503599627370496
    }
  ]
}
