enum CockpitInstanceStatus {
  ACTIVE
  REVOKED
}

model CockpitInstance {
  id                               String                        @id @default(cuid(2))
  createdAt                        DateTime                      @default(now())
  updatedAt                        DateTime                      @default(now()) @updatedAt
  userId                           String
  displayName                      String
  hostname                         String
  os                               String
  arch                             String
  cliVersion                       String
  status                           CockpitInstanceStatus         @default(ACTIVE)
  secretPrefix                     String                        @unique
  secretHash                       String
  // One-time registration-credential generation. Monotonic; starts at 1 on
  // create/rotate of the product secret. Consumption semantics (increment on
  // reissue, consume-on-enrollment) are owned by the API batch member.
  registrationCredentialGeneration Int                           @default(1)
  // Null means the current generation is still usable for one initial-daemon
  // enrollment create; set to the consumption time by the API member.
  registrationCredentialConsumedAt DateTime?
  lastSeenAt                       DateTime?
  revokedAt                        DateTime?
  User                             User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  EnterpriseLogBatches             EnterpriseLogBatch[]
  EnterpriseLogEvents              EnterpriseLogEvent[]
  Notifications                    Notification[]
  NotificationInstanceSettings     NotificationInstanceSetting[]
  InstanceAccessGrants             InstanceAccessGrant[]
  InstanceAuditEvents              InstanceAuditEvent[]
  RemoteEnrolledDevices            RemoteEnrolledDevice[]

  @@index([userId, status])
  @@index([lastSeenAt])
  @@map("cockpit_instance")
}
