enum RemoteAuthorityReplicaState {
  joining
  required
  draining
}

enum RemoteAuthoritySigningState {
  reserved
  signed
  finalized
  aborted
}

enum RemoteAuthorityFenceState {
  open
  closing
  frozen
}

enum RemoteAuthorityTransitionState {
  reserved
  status_signed
  committed
  aborted
}

model RemoteAuthorityReplicaMembership {
  deploymentId         String
  membershipGeneration Decimal                     @db.Decimal(20, 0)
  replicaId            String
  replicaGeneration    Decimal                     @db.Decimal(20, 0)
  state                RemoteAuthorityReplicaState
  updatedAt            DateTime                    @updatedAt

  @@id([deploymentId, replicaId])
  @@index([deploymentId, membershipGeneration, state])
  @@map("remote_authority_replica_memberships")
}

model RemoteAuthoritySigningJournal {
  mintId            String                      @id
  deploymentId      String
  signingGeneration Decimal                     @db.Decimal(20, 0)
  kid               String
  claimsHash        String
  state             RemoteAuthoritySigningState
  providerRequestId String                      @unique
  signatureP1363    String?
  compactJws        String?
  signedAt          DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@unique([deploymentId, mintId, claimsHash])
  @@index([deploymentId, kid, state])
  @@map("remote_authority_signing_journal")
}

model RemoteAuthoritySigningFence {
  deploymentId      String
  kid               String
  signingGeneration Decimal                   @db.Decimal(20, 0)
  state             RemoteAuthorityFenceState
  cutoff            DateTime?
  updatedAt         DateTime                  @updatedAt

  @@id([deploymentId, kid, signingGeneration])
  @@map("remote_authority_signing_fences")
}

model RemoteAuthorityLifecycleTransition {
  transitionId       String                         @id
  deploymentId       String
  state              RemoteAuthorityTransitionState
  fromRevision       Decimal                        @db.Decimal(20, 0)
  toRevision         Decimal                        @db.Decimal(20, 0)
  fromDigest         String
  toDigest           String
  fromAuthorityEpoch Decimal                        @db.Decimal(20, 0)
  toAuthorityEpoch   Decimal                        @db.Decimal(20, 0)
  fromCurrentKid     String
  toCurrentKid       String
  statusGeneration   Decimal                        @db.Decimal(20, 0)
  statusBodyDigest   String
  statusBodyJson     String
  statusCompactJws   String?
  signerKid          String
  signingGeneration  Decimal                        @db.Decimal(20, 0)
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt

  @@index([deploymentId, state])
  @@map("remote_authority_lifecycle_transitions")
}

model RemoteAuthorityLifecycleState {
  deploymentId    String   @id
  revision        Decimal  @db.Decimal(20, 0)
  ringDigest      String
  authorityEpoch  Decimal  @db.Decimal(20, 0)
  currentKid      String
  revokedKidsJson String
  generation      Decimal  @db.Decimal(20, 0)
  updatedAt       DateTime @updatedAt

  @@map("remote_authority_lifecycle_state")
}

model RemoteAuthorityStatus {
  deploymentId     String
  statusGeneration Decimal   @db.Decimal(20, 0)
  revision         Decimal   @db.Decimal(20, 0)
  ringDigest       String
  authorityEpoch   Decimal   @db.Decimal(20, 0)
  kid              String
  compactJws       String
  issuedAt         DateTime
  validUntil       DateTime
  finalizedAt      DateTime?

  @@id([deploymentId, statusGeneration])
  @@index([deploymentId, ringDigest, authorityEpoch, finalizedAt])
  @@map("remote_authority_statuses")
}

model RemoteAuthorityStatusLease {
  deploymentId    String   @id
  holderReplicaId String
  leaseGeneration Decimal  @db.Decimal(20, 0)
  expiresAt       DateTime
  updatedAt       DateTime @updatedAt

  @@map("remote_authority_status_leases")
}

model RemoteAuthorityRingSnapshot {
  deploymentId   String
  ringDigest     String
  revision       Decimal  @db.Decimal(20, 0)
  authorityEpoch Decimal  @db.Decimal(20, 0)
  canonicalJson  String
  observedAt     DateTime @default(now())

  @@id([deploymentId, ringDigest])
  @@map("remote_authority_ring_snapshots")
}

model RemoteAuthorityControlOutbox {
  eventId      String    @id
  deploymentId String
  generation   Decimal   @db.Decimal(20, 0)
  eventType    String
  payload      String
  createdAt    DateTime  @default(now())
  deliveredAt  DateTime?

  @@unique([deploymentId, generation, eventType])
  @@index([deploymentId, deliveredAt, generation])
  @@map("remote_authority_control_outbox")
}
